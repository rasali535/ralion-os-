{
  "name": "@ralion/desktop",
  "version": "2.4.1",
  "description": "Ralion Platform Desktop Application by Ras Ali Labs",
  "author": {
    "name": "Ras Ali Labs",
    "email": "support@rasalilabs.com",
    "url": "https://rasalilabs.com"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "pack": "electron-builder --dir --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.rasalilabs.ralion",
    "productName": "Ralion",
    "copyright": "Copyright © 2026 Ras Ali Labs",
    "directories": {
      "output": "dist-installer",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Ras Ali Labs",
      "artifactName": "ralion-desktop-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ralion",
      "artifactName": "ralion-desktop-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "electron-log": "^5.1.2",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.2"
  }
}
