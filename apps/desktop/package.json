{
  "name": "@ralion/desktop",
  "version": "1.0.0",
  "description": "Ralion Platform Desktop Application by Ras Ali Labs",
  "author": {
    "name": "Ras Ali Labs",
    "email": "support@rasalilabs.com",
    "url": "https://rasalilabs.com"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
